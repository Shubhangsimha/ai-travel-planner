# ── LLM ──────────────────────────────────────────────
# Google Gemini Developer API key
# Get it at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Aviationstack ─────────────────────────────────────
# Register at: https://aviationstack.com (free tier: 100 req/month)
# Used for real flight routes and schedules — prices are computed estimates
AVIATIONSTACK_API_KEY=your_aviationstack_api_key_here

# ── Overpass API (OpenStreetMap) ───────────────────────
# No key required — fully free, queries real hotel POI data
# Hotel prices are tier-based estimates, not live rates
# OVERPASS_API_URL is optional — defaults to public instance
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# ── OpenTripMap ───────────────────────────────────────
# Register at: https://opentripmap.io/product
OPENTRIPMAP_API_KEY=your_opentripmap_api_key_here

# ── ExchangeRate-API ──────────────────────────────────
# Register at: https://www.exchangerate-api.com
# Free tier: 1,500 requests/month
EXCHANGERATE_API_KEY=your_exchangerate_api_key_here

# ── App Config ────────────────────────────────────────
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]
